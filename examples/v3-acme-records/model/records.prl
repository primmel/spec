# The fictional demonstration: the forms plane — fields with their bind
# channels, the pass/fail judgment, and the result record a conformance
# test names. Every name is invented.

attribute_definition reference_load {
  name "Reference load"
  definition { The reference mass the comparison applies. }
  value_type number
  unit "kg"
  origin declared
}

class IndicationRecord#data {
  meter_id: string {
    modality SHALL
    definition { The meter under test }
  }
  error: string {
    modality SHALL
    definition { The indicated error }
  }
}

data_registry indication-runs {
  title "The indication runs"
  data_class IndicationRecord#data
}

form indication-record {
  name "The indication record"
  conformance_process /conf/indication-check
  field meter_id : string { description "The meter under test" required true }
  field reference_mass : number { unit "kg" measurement_method direct bind model.attributes.reference_load }
  field indicated_mass : number { unit "kg" measurement_method direct }
  field error : number { unit "kg" measurement_method derived }
  field within_tolerance : boolean { required true measurement_method evaluated targets { /req/metrology/indication } }
}

check form:indication-record:pass_fail {
  expression "ocl{within_tolerance}"
  description { The indicated error stays within the class tolerance. }
  ref derives-from "form:indication-record"
}

symbol e {
  type number
  quantity_kind mass
  unit "kg"
  kind observable
  origin observed
}

requirement /req/metrology/indication {
  name "The indication tolerance"
  limit {
    args {
      e  <- observable:e
      mu <- attribute:reference_load
    }
    expression {
      e <= mu / 1000
    }
  }
  verification { method testing }
}

conformance_test /conf/indication-check {
  name "The indication check"
  type Testing
  targets { /req/metrology/indication }
  result_forms { indication-record }
  run {
    performed_by laboratory
    store indication-runs
    inputs { applied_load }
  }
  variables {
    variable applied_load { type number unit "kg" source declared description "The load point the laboratory applies for this check" }
    variable e { type number unit "kg" source measured description "The indicated error" }
  }
}

check conformance_test:/conf/indication-check:acceptance_criteria {
  expression "ocl{e > 0 -> false else true}"
  ref derives-from "conformance_test:/conf/indication-check"
}
